                content: `// Interactive Aqua Bubble Generator
const btn = document.getElementById('bubble-btn');
const counterEl = document.getElementById('counter');
let count = 0;

function spawnBubble() {
  count++;
  if (counterEl) {
    counterEl.textContent = \`Bubbles created: \${count}\`;
  }

  const bubble = document.createElement('div');
  bubble.className = 'bubble';
  const size = Math.floor(Math.random() * 34) + 16;
  bubble.style.width = size + 'px';
  bubble.style.height = size + 'px';
  bubble.style.left = Math.random() * 90 + '%';
  bubble.style.bottom = '-30px';

  document.body.appendChild(bubble);
  setTimeout(() => bubble.remove(), 4000);
}

if (btn) {
  btn.addEventListener('click', () => {
    for (let i = 0; i < 4; i++) {
      setTimeout(spawnBubble, i * 120);
    }
  });
}`
            }
        };

        // Application State
        let activeFile = 'index.html';
        let openTabs = ['index.html', 'style.css', 'app.js'];
        let isSidebarOpen = true;
        let isPreviewOpen = true;
        let isMaximized = false;
        let isDarkMode = false;
        let isPotatoMode = false;
        let autoRunTimer = null;

        // DOM Elements
        const textarea = document.getElementById('code-textarea');
        const highlightPre = document.getElementById('code-highlight');
        const lineNumbers = document.getElementById('line-numbers');
        const fileTree = document.getElementById('file-tree');
        const tabsContainer = document.getElementById('tabs-container');
        const statusCursor = document.getElementById('status-cursor');
        const statusLang = document.getElementById('status-lang');
        const previewIframe = document.getElementById('preview-iframe');

        // Initialize Editor & Saved Settings on Load
        window.addEventListener('DOMContentLoaded', () => {
            loadSavedSettings();
            renderFileTree();
            renderTabs();
            loadFile(activeFile);
            runCode(false);
        });

        // Load Dark Mode & Potato Mode preferences from localStorage
        function loadSavedSettings() {
            try {
                const savedDark = localStorage.getItem('aeroglass_dark_mode') === 'true';
                const savedPotato = localStorage.getItem('aeroglass_potato_mode') === 'true';
                applyDarkMode(savedDark, false);
                applyPotatoMode(savedPotato, false);
            } catch (e) {
                // Fallback if storage is restricted
            }
        }

        function openSettingsModal() {
            document.getElementById('settings-modal').classList.remove('hidden');
        }

        function closeSettingsModal() {
            document.getElementById('settings-modal').classList.add('hidden');
        }

        function toggleDarkMode(enabled) {
            applyDarkMode(enabled, true);
        }

        function applyDarkMode(enabled, notify = true) {
            isDarkMode = enabled;
            document.body.classList.toggle('dark-mode', enabled);
            const toggleEl = document.getElementById('dark-mode-toggle');
            if (toggleEl) toggleEl.checked = enabled;
            try {
                localStorage.setItem('aeroglass_dark_mode', String(enabled));
            } catch (e) {}
            renderFileTree();
            renderTabs();
            if (notify) {
                showToast(enabled ? 'Dark Mode enabled' : 'Light Aero Mode enabled');
            }
        }

        function togglePotatoMode(enabled) {
            applyPotatoMode(enabled, true);
        }

        function applyPotatoMode(enabled, notify = true) {
            isPotatoMode = enabled;
            document.body.classList.toggle('potato-mode', enabled);
            const toggleEl = document.getElementById('potato-mode-toggle');
            if (toggleEl) toggleEl.checked = enabled;

            const badge = document.getElementById('potato-badge');
            if (badge) {
                if (enabled) {
                    badge.classList.remove('hidden');
                    badge.classList.add('inline-flex');
                } else {
                    badge.classList.add('hidden');
                    badge.classList.remove('inline-flex');
                }
            }

            try {
                localStorage.setItem('aeroglass_potato_mode', String(enabled));
            } catch (e) {}

            if (notify) {
                showToast(enabled ? '🥔 Potato Mode ON — Maximum FPS!' : '✨ Full Aero Glass effects restored!');
            }
        }

        // Sync Scroll between Textarea, Syntax Pre, and Line Numbers
        textarea.addEventListener('scroll', () => {
            highlightPre.scrollTop = textarea.scrollTop;
            highlightPre.scrollLeft = textarea.scrollLeft;
            lineNumbers.scrollTop = textarea.scrollTop;
        });

        textarea.addEventListener('input', updateEditorView);
        textarea.addEventListener('click', updateCursorPosition);
        textarea.addEventListener('keyup', updateCursorPosition);

        // Support Tab Key Indentation inside Textarea
        textarea.addEventListener('keydown', (e) => {
            if (e.key === 'Tab') {
                e.preventDefault();
                const start = textarea.selectionStart;
                const end = textarea.selectionEnd;
                textarea.value = textarea.value.substring(0, start) + '  ' + textarea.value.substring(end);
                textarea.selectionStart = textarea.selectionEnd = start + 2;
                updateEditorView();
            }
        });

        // Update Status Bar Line & Column Indicator
        function updateCursorPosition() {
            const pos = textarea.selectionStart;
            const textBefore = textarea.value.substring(0, pos);
            const lines = textBefore.split('\n');
            const ln = lines.length;
            const col = lines[lines.length - 1].length + 1;
            statusCursor.textContent = `Ln ${ln}, Col ${col}`;
        }

        // Render File Explorer Sidebar
        function renderFileTree() {
            fileTree.innerHTML = '';
            Object.keys(projectFiles).forEach(filename => {
                const file = projectFiles[filename];
                const isActive = filename === activeFile;
                const btn = document.createElement('button');
                const activeClasses = isDarkMode
                    ? 'bg-slate-800/85 text-sky-300 shadow-sm border border-sky-400/40 font-semibold'
                    : 'bg-white/75 text-sky-900 shadow-sm border border-white font-semibold';
                const inactiveClasses = isDarkMode
                    ? 'text-slate-300 hover:bg-slate-800/45'
                    : 'text-slate-700 hover:bg-white/45';
                btn.className = `w-full flex items-center justify-between px-3 py-2 rounded-xl text-xs font-medium transition ${
                    isActive ? activeClasses : inactiveClasses
                }`;
                btn.onclick = () => switchFile(filename);

                btn.innerHTML = `
                    <span class="flex items-center gap-2 truncate">
                        <i class="ph-fill ${file.icon} text-base"></i>
                        <span class="truncate">${file.name}</span>
                    </span>
                    ${isActive ? '<span class="w-1.5 h-1.5 rounded-full bg-sky-500"></span>' : ''}
                `;
                fileTree.appendChild(btn);
            });
        }

        // Render Top Editor File Tabs
        function renderTabs() {
            tabsContainer.innerHTML = '';
            openTabs.forEach(filename => {
                const file = projectFiles[filename];
                if (!file) return;
                const isActive = filename === activeFile;

                const tab = document.createElement('div');
                const inactiveTabClass = isDarkMode
                    ? 'text-slate-300 hover:bg-slate-800/45 font-medium'
                    : 'text-slate-600 hover:bg-white/40 font-medium';
                tab.className = `h-full px-3 rounded-t-xl flex items-center gap-2 text-xs cursor-pointer transition select-none ${
                    isActive 
                    ? 'aero-tab-active text-slate-900 font-semibold' 
                    : inactiveTabClass
                }`;
                tab.onclick = () => switchFile(filename);

                tab.innerHTML = `
                    <i class="ph-fill ${file.icon} text-sm"></i>
                    <span>${file.name}</span>
                `;

                if (openTabs.length > 1) {
                    const closeBtn = document.createElement('button');
                    closeBtn.className = 'ml-1 p-0.5 rounded-full hover:bg-slate-400/30 text-slate-500 hover:text-slate-800';
                    closeBtn.innerHTML = '<i class="ph-bold ph-x text-[10px]"></i>';
                    closeBtn.onclick = (e) => {
                        e.stopPropagation();
                        closeTab(filename);
                    };
                    tab.appendChild(closeBtn);
                }

                tabsContainer.appendChild(tab);
            });
        }

        // Switch Active File
        function switchFile(filename) {
            if (!projectFiles[filename]) return;
            if (!openTabs.includes(filename)) {
                openTabs.push(filename);
            }
            activeFile = filename;
            loadFile(filename);
            renderFileTree();
            renderTabs();
        }

        function loadFile(filename) {
            const file = projectFiles[filename];
            textarea.value = file.content;
            statusLang.textContent = file.lang.toUpperCase();
            textarea.scrollTop = 0;
            textarea.scrollLeft = 0;
            updateEditorView();
        }

        // Update Line Numbers, Syntax Highlighting Overlay, and Live Preview
        function updateEditorView() {
            const code = textarea.value;
            if (projectFiles[activeFile]) {
                projectFiles[activeFile].content = code;
            }

            // Update line numbers gutter
            const lineCount = code.split('\n').length;
            let linesHtml = '';
            for (let i = 1; i <= lineCount; i++) {
                linesHtml += i + '<br>';
            }
            lineNumbers.innerHTML = linesHtml;

            // Render syntax-highlighted overlay (trailing newline prevents scroll mismatch)
            const lang = projectFiles[activeFile] ? projectFiles[activeFile].lang : 'html';
            highlightPre.innerHTML = highlightSyntax(code, lang) + (code.endsWith('\n') ? ' ' : '');

            updateCursorPosition();

            // Debounced live preview refresh
            const autoRun = document.getElementById('auto-run-checkbox');
            if (autoRun && autoRun.checked) {
                clearTimeout(autoRunTimer);
                autoRunTimer = setTimeout(() => runCode(false), 300);
            }
        }

        // Lightweight Tokenizer for HTML, CSS, and JS
        function highlightSyntax(code, lang) {
            const escaped = code
                .replace(/&/g, '&amp;')
                .replace(/</g, '&lt;')
                .replace(/>/g, '&gt;');

            if (lang === 'html') {
                return escaped
                    .replace(/(&lt;!--[\s\S]*?--&gt;)/g, '<span class="tok-comm">$1</span>')
                    .replace(/(&lt;\/?[a-zA-Z0-9-]+)([\s\S]*?)(\/?&gt;)/g, (match, open, attrs, close) => {
                        const coloredAttrs = attrs.replace(/([a-zA-Z-:]+)(=)(".*?"|'.*?')/g,
                            '<span class="tok-attr">$1</span><span class="tok-punc">$2</span><span class="tok-str">$3</span>');
                        return `<span class="tok-tag">${open}</span>${coloredAttrs}<span class="tok-tag">${close}</span>`;
                    });
            }

            if (lang === 'css') {
                return escaped
                    .replace(/(\/\*[\s\S]*?\*\/)/g, '<span class="tok-comm">$1</span>')
                    .replace(/([a-zA-Z-]+)(\s*:)/g, '<span class="tok-prop">$1</span><span class="tok-punc">$2</span>')
                    .replace(/(#[0-9a-fA-F]{3,8}\b|\b\d+(?:\.\d+)?(?:px|em|rem|%|vh|vw|s|deg)?\b)/g, '<span class="tok-num">$1</span>')
                    .replace(/('.*?'|".*?")/g, '<span class="tok-str">$1</span>');
            }

            // Default: JavaScript
            return escaped
                .replace(/(\/\/.*$|\/\*[\s\S]*?\*\/)/gm, '<span class="tok-comm">$1</span>')
                .replace(/('.*?'|".*?"|`[\s\S]*?`)/g, '<span class="tok-str">$1</span>')
                .replace(/\b(const|let|var|function|return|if|else|for|while|new|true|false|null|undefined|try|catch)\b/g, '<span class="tok-kw">$1</span>')
                .replace(/\b(\d+(?:\.\d+)?)\b/g, '<span class="tok-num">$1</span>');
        }

        function closeTab(filename) {
            openTabs = openTabs.filter(t => t !== filename);
            if (activeFile === filename) {
                activeFile = openTabs[openTabs.length - 1];
                loadFile(activeFile);
            }
            renderTabs();
            renderFileTree();
        }

        // Compile HTML + CSS + JS into Live Preview Iframe
        function runCode(notify = false) {
            if (!isPreviewOpen && notify) {
                togglePreviewPane();
            }

            let htmlContent = projectFiles['index.html'] ? projectFiles['index.html'].content : '';
            let cssContent = '';
            let jsContent = '';

            // Collect all CSS and JS files in the workspace
            Object.values(projectFiles).forEach(file => {
                if (file.lang === 'css') cssContent += `\n/* ${file.name} */\n` + file.content;
                if (file.lang === 'js') jsContent += `\n// ${file.name}\n` + file.content;
            });

            // Build combined document for srcdoc
            const combinedDoc = `
                <!DOCTYPE html>
                <html>
                <head>
                    <meta charset="UTF-8">
                    <style>${cssContent}</style>
                </head>
                <body>
                    ${htmlContent}
                    <script>
                        try {
                            ${jsContent}
                        } catch (err) {
                            console.error(err);
                        }
                    <\/script>
                </body>
                </html>
            `;

            previewIframe.srcdoc = combinedDoc;

            if (notify) {
                showToast('Live preview refreshed!');
            }
        }

        // Toggle Collapsible Explorer Sidebar
        function toggleSidebar() {
            const sidebar = document.getElementById('sidebar');
            isSidebarOpen = !isSidebarOpen;
            if (isSidebarOpen) {
                sidebar.classList.remove('w-0', 'opacity-0', 'border-r-0');
                sidebar.classList.add('w-56', 'sm:w-60');
            } else {
                sidebar.classList.remove('w-56', 'sm:w-60');
                sidebar.classList.add('w-0', 'opacity-0', 'border-r-0');
            }
        }

        // Toggle Split Live Preview Pane
        function togglePreviewPane() {
            const previewSection = document.getElementById('preview-section');
            isPreviewOpen = !isPreviewOpen;
            if (isPreviewOpen) {
                previewSection.classList.remove('hidden');
                previewSection.classList.add('flex');
                runCode(false);
            } else {
                previewSection.classList.remove('flex');
                previewSection.classList.add('hidden');
            }
        }

        // Toggle Window Fullscreen / Floating Glass Mode
        function toggleMaximize() {
            const win = document.getElementById('aero-window');
            isMaximized = !isMaximized;
            if (isMaximized) {
                win.classList.remove('max-w-6xl', 'max-h-[860px]', 'rounded-2xl');
                win.classList.add('max-w-full', 'max-h-full', 'rounded-none');
                document.body.classList.remove('p-2', 'sm:p-5', 'md:p-8');
            } else {
                win.classList.add('max-w-6xl', 'max-h-[860px]', 'rounded-2xl');
                win.classList.remove('max-w-full', 'max-h-full', 'rounded-none');
                document.body.classList.add('p-2', 'sm:p-5', 'md:p-8');
            }
        }

        // New File Modal Handlers
        function createNewFile() {
            const modal = document.getElementById('new-file-modal');
            const input = document.getElementById('new-file-input');
            modal.classList.remove('hidden');
            input.value = '';
            input.focus();
        }

        function closeNewFileModal() {
            document.getElementById('new-file-modal').classList.add('hidden');
        }

        function confirmNewFile() {
            const rawName = document.getElementById('new-file-input').value.trim();
            if (!rawName) return;

            const ext = rawName.split('.').pop().toLowerCase();
            let lang = 'html';
            let icon = 'ph-file-code text-sky-600';

            if (ext === 'css') {
                lang = 'css';
                icon = 'ph-file-css text-sky-500';
            } else if (ext === 'js') {
                lang = 'js';
                icon = 'ph-file-js text-amber-500';
            } else if (ext === 'html') {
                lang = 'html';
                icon = 'ph-file-html text-orange-500';
            }

            if (projectFiles[rawName]) {
                showToast('File already exists!');
                closeNewFileModal();
                switchFile(rawName);
                return;
            }

            projectFiles[rawName] = {
                name: rawName,
                lang,
                icon,
                content: `// ${rawName} - Created in AeroGlass Studio\n`
            };

            closeNewFileModal();
            switchFile(rawName);
            showToast(`Created ${rawName}`);
        }

        document.getElementById('new-file-input').addEventListener('keydown', (e) => {
            if (e.key === 'Enter') confirmNewFile();
            if (e.key === 'Escape') closeNewFileModal();
        });

        // Copy Code using fallback execCommand for iframe compatibility
        function copyCurrentCode() {
            textarea.select();
            try {
                document.execCommand('copy');
                showToast(`Copied ${activeFile} to clipboard!`);
            } catch (err) {
                showToast('Unable to copy text');
            }
            window.getSelection().removeAllRanges();
        }

        // Simple Indentation Beautifier
        function formatCode() {
            const lines = textarea.value.split('\n');
            let indent = 0;
            const formatted = lines.map(line => {
                const trimmed = line.trim();
                if (trimmed.startsWith('}') || trimmed.startsWith('</')) {
                    indent = Math.max(0, indent - 1);
                }
                const result = '  '.repeat(indent) + trimmed;
                if (trimmed.endsWith('{') || (trimmed.startsWith('<') && !trimmed.startsWith('</') && !trimmed.endsWith('/>') && !trimmed.includes('</') && !trimmed.startsWith('<!'))) {
                    indent++;
                }
                return result;
            }).join('\n');

            textarea.value = formatted;
            updateEditorView();
            showToast('Code formatted!');
        }

        // Glass Toast Helper
        let toastTimeout;
        function showToast(msg) {
            const toast = document.getElementById('aero-toast');
            document.getElementById('aero-toast-msg').textContent = msg;
            toast.classList.remove('opacity-0', 'translate-y-2');
            clearTimeout(toastTimeout);
            toastTimeout = setTimeout(() => {
                toast.classList.add('opacity-0', 'translate-y-2');
            }, 2400);
        }
    </script>
</body>
</html>
