<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Online Code Lessons</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- Google Fonts: Inter & JetBrains Mono -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:ital,wght@0,400;0,500;0,600;1,400&display=swap" rel="stylesheet">
    <script src="https://unpkg.com/@phosphor-icons/web"></script>

    <style>
        /* Base Typography & Reset */
        body {
            font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
            overflow: hidden;
            user-select: none;
        }

        .code-font {
            font-family: 'JetBrains Mono', monospace;
            font-variant-ligatures: contextual;
        }

        /* Frutiger Aero Wallpaper Background with Aurora, Bokeh & Orbs */
        .aero-wallpaper {
            background: radial-gradient(circle at 15% 15%, #a8edea 0%, transparent 45%),
                        radial-gradient(circle at 85% 20%, #74ebd5 0%, transparent 50%),
                        radial-gradient(circle at 50% 85%, #4facfe 0%, transparent 60%),
                        linear-gradient(135deg, #00c6fb 0%, #005bea 45%, #38f9d7 100%);
            position: relative;
        }

        /* Animated Floating Bokeh & Aurora Waves */
        .aurora-wave {
            position: absolute;
            width: 140%;
            height: 60%;
            top: -10%;
            left: -20%;
            background: linear-gradient(90deg, rgba(255,255,255,0.1) 0%, rgba(168,255,120,0.35) 35%, rgba(120,255,214,0.4) 65%, rgba(255,255,255,0.1) 100%);
            filter: blur(55px);
            transform: rotate(-12deg);
            animation: auroraDrift 16s ease-in-out infinite alternate;
            pointer-events: none;
        }

        .bokeh-orb {
            position: absolute;
            border-radius: 50%;
            background: radial-gradient(circle at 30% 30%, rgba(255, 255, 255, 0.85), rgba(255, 255, 255, 0.2) 60%, rgba(255, 255, 255, 0.05) 100%);
            box-shadow: inset 0 0 15px rgba(255, 255, 255, 0.8), 0 8px 32px rgba(0, 140, 255, 0.2);
            backdrop-filter: blur(4px);
            pointer-events: none;
            animation: floatOrb 12s ease-in-out infinite alternate;
        }

        @keyframes auroraDrift {
            0% { transform: rotate(-12deg) translateY(0px) scale(1); }
            100% { transform: rotate(-8deg) translateY(30px) scale(1.05); }
        }

        @keyframes floatOrb {
            0% { transform: translateY(0px) translateX(0px); }
            100% { transform: translateY(-25px) translateX(15px); }
        }

        /* macOS + Frutiger Aero Frosted Glass Window */
        .aero-window {
            background: linear-gradient(165deg, rgba(255, 255, 255, 0.52) 0%, rgba(255, 255, 255, 0.32) 50%, rgba(235, 248, 255, 0.42) 100%);
            backdrop-filter: blur(28px) saturate(180%);
            -webkit-backdrop-filter: blur(28px) saturate(180%);
            border: 1px solid rgba(255, 255, 255, 0.75);
            box-shadow: 
                0 25px 65px -12px rgba(0, 45, 95, 0.38),
                0 0 1px 1px rgba(255, 255, 255, 0.5) inset,
                0 2px 10px rgba(255, 255, 255, 0.7) inset;
            transition: all 0.3s cubic-bezier(0.22, 1, 0.36, 1);
        }

        /* Glossy Top Titlebar Reflection */
        .aero-titlebar {
            background: linear-gradient(180deg, 
                rgba(255, 255, 255, 0.78) 0%, 
                rgba(255, 255, 255, 0.48) 49%, 
                rgba(230, 245, 255, 0.35) 51%, 
                rgba(255, 255, 255, 0.45) 100%);
            border-bottom: 1px solid rgba(255, 255, 255, 0.65);
            box-shadow: 0 1px 4px rgba(0, 80, 150, 0.06);
        }

        /* Glossy Frutiger Aero Pill Buttons */
        .aero-btn {
            background: linear-gradient(180deg, 
                rgba(255, 255, 255, 0.9) 0%, 
                rgba(235, 248, 255, 0.65) 48%, 
                rgba(205, 235, 255, 0.55) 52%, 
                rgba(240, 252, 255, 0.85) 100%);
            border: 1px solid rgba(255, 255, 255, 0.85);
            box-shadow: 0 2px 6px rgba(0, 90, 170, 0.14), inset 0 1px 1px rgba(255, 255, 255, 0.95);
            transition: all 0.18s ease;
        }

        .aero-btn:hover {
            background: linear-gradient(180deg, 
                rgba(255, 255, 255, 1) 0%, 
                rgba(220, 245, 255, 0.85) 48%, 
                rgba(185, 230, 255, 0.75) 52%, 
                rgba(240, 252, 255, 0.95) 100%);
            box-shadow: 0 4px 12px rgba(0, 130, 255, 0.25), inset 0 1px 2px #fff;
            transform: translateY(-0.5px);
        }

        .aero-btn:active {
            transform: translateY(0.5px);
        }

        /* Glossy Green/Cyan Run Button */
        .aero-run-btn {
            background: linear-gradient(180deg, 
                #8ef7a8 0%, 
                #34d399 48%, 
                #10b981 52%, 
                #34d399 100%);
            border: 1px solid rgba(255, 255, 255, 0.85);
            box-shadow: 0 3px 10px rgba(16, 185, 129, 0.35), inset 0 1px 2px rgba(255, 255, 255, 0.9);
            color: #043927;
            text-shadow: 0 1px 0 rgba(255, 255, 255, 0.6);
            transition: all 0.18s ease;
        }

        .aero-run-btn:hover {
            filter: brightness(1.06);
            box-shadow: 0 4px 14px rgba(16, 185, 129, 0.5), inset 0 1px 2px rgba(255, 255, 255, 1);
            transform: translateY(-0.5px);
        }

        /* macOS Traffic Lights with Glossy Specular Highlight */
        .traffic-light {
            width: 13px;
            height: 13px;
            border-radius: 50%;
            position: relative;
            box-shadow: inset 0 -1px 2px rgba(0,0,0,0.25), 0 1px 1px rgba(255,255,255,0.7);
            transition: transform 0.15s ease;
        }
        .traffic-light::after {
            content: '';
            position: absolute;
            top: 1.5px;
            left: 2.5px;
            width: 7px;
            height: 4px;
            border-radius: 50%;
            background: linear-gradient(180deg, rgba(255,255,255,0.9), rgba(255,255,255,0.1));
        }
        .traffic-light:hover {
            transform: scale(1.08);
        }

        /* Active File Tab Styling */
        .aero-tab-active {
            background: linear-gradient(180deg, rgba(255, 255, 255, 0.85) 0%, rgba(255, 255, 255, 0.55) 100%);
            border: 1px solid rgba(255, 255, 255, 0.9);
            border-bottom-color: transparent;
            box-shadow: 0 -2px 8px rgba(0, 110, 210, 0.08), inset 0 1px 1px #fff;
        }

        /* Editor Overlay Architecture for Live Syntax Highlighting + Typeable Textarea */
        .editor-container {
            position: relative;
            flex: 1;
            overflow: hidden;
            background: rgba(255, 255, 255, 0.42);
        }

        .editor-layer {
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            margin: 0;
            padding: 16px 20px;
            font-family: 'JetBrains Mono', monospace;
            font-size: 13.5px;
            line-height: 1.65;
            tab-size: 2;
            white-space: pre;
            overflow: auto;
            border: none;
            outline: none;
        }

        #code-textarea {
            color: transparent;
            background: transparent;
            caret-color: #005bea;
            resize: none;
            z-index: 2;
            user-select: text;
        }

        #code-textarea::selection {
            background: rgba(56, 189, 248, 0.32);
        }

        #code-highlight {
            z-index: 1;
            pointer-events: none;
            color: #1e293b;
        }

        /* Syntax Highlighting Colors (Crisp Aero Palette) */
        .tok-tag { color: #0284c7; font-weight: 600; }
        .tok-attr { color: #0d9488; }
        .tok-str { color: #16a34a; }
        .tok-kw { color: #7c3aed; font-weight: 600; }
        .tok-num { color: #ea580c; }
        .tok-comm { color: #64748b; font-style: italic; }
        .tok-prop { color: #0369a1; }
        .tok-punc { color: #475569; }

        /* Glossy Status Bar */
        .aero-statusbar {
            background: linear-gradient(180deg, 
                rgba(220, 244, 255, 0.72) 0%, 
                rgba(185, 230, 255, 0.65) 50%, 
                rgba(165, 220, 255, 0.78) 100%);
            border-top: 1px solid rgba(255, 255, 255, 0.8);
        }

        /* Custom Glass Scrollbars */
        ::-webkit-scrollbar {
            width: 8px;
            height: 8px;
        }
        ::-webkit-scrollbar-track {
            background: rgba(255, 255, 255, 0.15);
        }
        ::-webkit-scrollbar-thumb {
            background: rgba(255, 255, 255, 0.65);
            border-radius: 9999px;
            border: 1px solid rgba(0, 120, 215, 0.15);
        }
        ::-webkit-scrollbar-thumb:hover {
            background: rgba(255, 255, 255, 0.9);
        }

        /* =========================================================
           1. DARK MODE (Deep Obsidian & Glowing Aqua Glassmorphism)
           ========================================================= */
        body.dark-mode.aero-wallpaper {
            background: radial-gradient(circle at 15% 15%, #0d3b66 0%, transparent 45%),
                        radial-gradient(circle at 85% 20%, #064e3b 0%, transparent 50%),
                        radial-gradient(circle at 50% 85%, #0284c7 0%, transparent 60%),
                        linear-gradient(135deg, #020617 0%, #09152b 50%, #042f2e 100%);
        }

        body.dark-mode .aurora-wave {
            background: linear-gradient(90deg, rgba(14,165,233,0.08) 0%, rgba(16,185,129,0.28) 35%, rgba(56,189,248,0.3) 65%, rgba(14,165,233,0.08) 100%);
        }

        body.dark-mode .bokeh-orb {
            background: radial-gradient(circle at 30% 30%, rgba(56, 189, 248, 0.45), rgba(16, 185, 129, 0.12) 60%, rgba(2, 6, 23, 0.05) 100%);
            box-shadow: inset 0 0 15px rgba(125, 211, 252, 0.45), 0 8px 32px rgba(0, 0, 0, 0.55);
        }

        body.dark-mode .aero-window {
            background: linear-gradient(165deg, rgba(15, 23, 42, 0.72) 0%, rgba(9, 14, 28, 0.65) 50%, rgba(6, 28, 44, 0.72) 100%);
            border: 1px solid rgba(56, 189, 248, 0.35);
            box-shadow: 
                0 25px 65px -12px rgba(0, 0, 0, 0.75),
                0 0 1px 1px rgba(56, 189, 248, 0.25) inset,
                0 2px 12px rgba(56, 189, 248, 0.18) inset;
        }

        body.dark-mode .aero-titlebar {
            background: linear-gradient(180deg, 
                rgba(30, 41, 59, 0.85) 0%, 
                rgba(15, 23, 42, 0.72) 49%, 
                rgba(9, 14, 28, 0.68) 51%, 
                rgba(15, 23, 42, 0.78) 100%);
            border-bottom: 1px solid rgba(56, 189, 248, 0.28);
        }

        body.dark-mode .aero-btn {
            background: linear-gradient(180deg, 
                rgba(51, 65, 85, 0.85) 0%, 
                rgba(30, 41, 59, 0.75) 48%, 
                rgba(15, 23, 42, 0.8) 52%, 
                rgba(30, 41, 59, 0.85) 100%);
            border: 1px solid rgba(125, 211, 252, 0.35);
            box-shadow: 0 2px 6px rgba(0, 0, 0, 0.4), inset 0 1px 1px rgba(255, 255, 255, 0.18);
            color: #e2e8f0;
        }

        body.dark-mode .aero-btn:hover {
            background: linear-gradient(180deg, 
                rgba(71, 85, 105, 0.92) 0%, 
                rgba(30, 58, 95, 0.85) 48%, 
                rgba(15, 35, 65, 0.88) 52%, 
                rgba(30, 58, 95, 0.92) 100%);
            border-color: rgba(56, 189, 248, 0.65);
            color: #ffffff;
        }

        body.dark-mode #sidebar {
            background: rgba(10, 16, 30, 0.52);
            border-color: rgba(56, 189, 248, 0.22);
        }

        body.dark-mode #editor-section > div:first-child {
            background: rgba(10, 16, 30, 0.45);
            border-color: rgba(56, 189, 248, 0.22);
        }

        body.dark-mode .aero-tab-active {
            background: linear-gradient(180deg, rgba(30, 41, 59, 0.92) 0%, rgba(15, 23, 42, 0.82) 100%);
            border: 1px solid rgba(56, 189, 248, 0.4);
            border-bottom-color: transparent;
            box-shadow: 0 -2px 8px rgba(56, 189, 248, 0.15), inset 0 1px 1px rgba(255, 255, 255, 0.2);
            color: #f8fafc !important;
        }

        body.dark-mode .editor-container {
            background: rgba(8, 13, 25, 0.62);
        }

        body.dark-mode #line-numbers {
            background: rgba(10, 16, 30, 0.55);
            border-color: rgba(56, 189, 248, 0.2);
            color: #64748b;
        }

        body.dark-mode #code-textarea {
            caret-color: #38bdf8;
        }

        body.dark-mode #code-highlight {
            color: #e2e8f0;
        }

        /* High-Contrast Dark Syntax Highlighting */
        body.dark-mode .tok-tag { color: #38bdf8; }
        body.dark-mode .tok-attr { color: #2dd4bf; }
        body.dark-mode .tok-str { color: #4ade80; }
        body.dark-mode .tok-kw { color: #c084fc; }
        body.dark-mode .tok-num { color: #fb923c; }
        body.dark-mode .tok-comm { color: #64748b; }
        body.dark-mode .tok-prop { color: #7dd3fc; }
        body.dark-mode .tok-punc { color: #94a3b8; }

        body.dark-mode #preview-section {
            background: rgba(15, 23, 42, 0.65);
            border-color: rgba(56, 189, 248, 0.28);
        }

        body.dark-mode #preview-section > div:first-child {
            background: linear-gradient(90deg, rgba(30, 41, 59, 0.85), rgba(15, 23, 42, 0.8));
            border-color: rgba(56, 189, 248, 0.25);
        }

        body.dark-mode .aero-statusbar {
            background: linear-gradient(180deg, 
                rgba(15, 35, 58, 0.88) 0%, 
                rgba(10, 24, 42, 0.88) 50%, 
                rgba(8, 18, 34, 0.94) 100%);
            border-top: 1px solid rgba(56, 189, 248, 0.3);
            color: #cbd5e1;
        }

        body.dark-mode .dark-text-light {
            color: #f1f5f9 !important;
        }

        body.dark-mode .dark-text-muted {
            color: #94a3b8 !important;
        }

        body.dark-mode .dark-surface-pill {
            background: rgba(15, 23, 42, 0.72) !important;
            border-color: rgba(56, 189, 248, 0.35) !important;
            color: #e2e8f0 !important;
        }

        /* =========================================================
           2. POTATO MODE (Zero Blur, Flat Solids, Maximum FPS)
           ========================================================= */
        body.potato-mode * {
            backdrop-filter: none !important;
            -webkit-backdrop-filter: none !important;
            box-shadow: none !important;
            text-shadow: none !important;
            animation: none !important;
            transition: none !important;
        }

        body.potato-mode.aero-wallpaper {
            background: #b8d4e8 !important;
        }

        body.potato-mode.dark-mode.aero-wallpaper {
            background: #0b0f17 !important;
        }

        body.potato-mode .aurora-wave,
        body.potato-mode .bokeh-orb {
            display: none !important;
        }

        body.potato-mode .aero-window {
            background: #e6eff6 !important;
            border: 2px solid #8faec4 !important;
        }

        body.potato-mode.dark-mode .aero-window {
            background: #141a24 !important;
            border: 2px solid #2b384d !important;
        }

        body.potato-mode .aero-titlebar {
            background: #d2e2ee !important;
            border-bottom: 1px solid #9cb8cc !important;
        }

        body.potato-mode.dark-mode .aero-titlebar {
            background: #1c2432 !important;
            border-bottom: 1px solid #2e3c52 !important;
        }

        body.potato-mode .aero-btn {
            background: #ffffff !important;
            border: 1px solid #94b0c4 !important;
            transform: none !important;
        }

        body.potato-mode.dark-mode .aero-btn {
            background: #253042 !important;
            border: 1px solid #3c4d69 !important;
            color: #e2e8f0 !important;
        }

        body.potato-mode .aero-run-btn {
            background: #22c55e !important;
            border: 1px solid #15803d !important;
            color: #ffffff !important;
            transform: none !important;
        }

        body.potato-mode #sidebar {
            background: #dce8f2 !important;
            border-color: #9cb8cc !important;
        }

        body.potato-mode.dark-mode #sidebar {
            background: #18202c !important;
            border-color: #2e3c52 !important;
        }

        body.potato-mode .editor-container {
            background: #ffffff !important;
        }

        body.potato-mode.dark-mode .editor-container {
            background: #0f141d !important;
        }

        body.potato-mode #line-numbers {
            background: #eef4f8 !important;
            border-color: #cbd5e1 !important;
        }

        body.potato-mode.dark-mode #line-numbers {
            background: #141a24 !important;
            border-color: #283447 !important;
        }

        body.potato-mode .aero-tab-active {
            background: #ffffff !important;
            border-color: #9cb8cc !important;
        }

        body.potato-mode.dark-mode .aero-tab-active {
            background: #0f141d !important;
            border-color: #2e3c52 !important;
        }

        body.potato-mode .aero-statusbar {
            background: #cde0ee !important;
            border-top: 1px solid #9cb8cc !important;
        }

        body.potato-mode.dark-mode .aero-statusbar {
            background: #1c2432 !important;
            border-top: 1px solid #2e3c52 !important;
        }

        body.potato-mode .traffic-light::after {
            display: none !important;
        }
    </style>
</head>
<body class="aero-wallpaper h-screen w-screen flex items-center justify-center p-2 sm:p-5 md:p-8">

    <!-- Decorative Frutiger Aero Ambient Elements -->
    <div class="aurora-wave"></div>
    <div class="bokeh-orb w-48 h-48 top-8 left-12 opacity-60" style="animation-delay: 0s;"></div>
    <div class="bokeh-orb w-72 h-72 bottom-10 right-16 opacity-50" style="animation-delay: -4s;"></div>
    <div class="bokeh-orb w-32 h-32 top-1/3 right-1/4 opacity-70" style="animation-delay: -8s;"></div>
    <div class="bokeh-orb w-24 h-24 bottom-1/4 left-1/3 opacity-65" style="animation-delay: -2s;"></div>

    <!-- Main macOS + Frutiger Aero Frosted Glass Window -->
    <main id="aero-window" class="aero-window w-full max-w-6xl h-full max-h-[860px] rounded-2xl flex flex-col overflow-hidden relative z-10">
        
        <!-- Top Glossy Titlebar -->
        <header class="aero-titlebar h-12 px-4 flex items-center justify-between shrink-0">
            <!-- Left: macOS Traffic Lights & Sidebar Toggle -->
            <div class="flex items-center gap-4">
                <div class="flex items-center gap-2 group" title="Window Controls">
                    <button onclick="showToast('Window minimize/close simulated in browser preview')" class="traffic-light bg-[#ff5f56] flex items-center justify-center text-[9px] text-red-950 font-bold opacity-95">
                        <span class="opacity-0 group-hover:opacity-100 transition-opacity">×</span>
                    </button>
                    <button onclick="showToast('Minimized state simulated')" class="traffic-light bg-[#ffbd2e] flex items-center justify-center text-[9px] text-amber-950 font-bold opacity-95">
                        <span class="opacity-0 group-hover:opacity-100 transition-opacity">−</span>
                    </button>
                    <button onclick="toggleMaximize()" class="traffic-light bg-[#27c93f] flex items-center justify-center text-[8px] text-emerald-950 font-bold opacity-95" title="Toggle Fullscreen Window">
                        <span class="opacity-0 group-hover:opacity-100 transition-opacity">+</span>
                    </button>
                </div>

                <div class="h-4 w-[1px] bg-white/60 hidden sm:block"></div>

                <!-- Sidebar Toggle Button -->
                <button id="toggle-sidebar-btn" onclick="toggleSidebar()" class="aero-btn p-1.5 rounded-lg text-slate-700 hover:text-sky-700 flex items-center gap-1.5 text-xs font-medium" title="Toggle Explorer Sidebar">
                    <i class="ph-bold ph-sidebar-simple text-base text-sky-600"></i>
                    <span class="hidden md:inline">Explorer</span>
                </button>
            </div>

            <!-- Center: Glossy Aero App Pill Badge -->
            <div class="dark-surface-pill flex items-center gap-2 px-3.5 py-1 rounded-full bg-white/45 border border-white/75 shadow-inner">
                <span class="w-2.5 h-2.5 rounded-full bg-gradient-to-tr from-sky-500 to-emerald-300 shadow-sm animate-pulse"></span>
                <span class="dark-text-light text-xs sm:text-sm font-semibold text-slate-800 tracking-tight">AeroGlass Studio</span>
                <span class="hidden sm:inline text-[11px] font-medium text-sky-700 bg-sky-100/80 px-2 py-0.5 rounded-full border border-white">2026 Edition</span>
            </div>

            <!-- Right: Settings, Split Preview Toggle & Run Button -->
            <div class="flex items-center gap-2">
                <button onclick="openSettingsModal()" class="aero-btn p-1.5 sm:px-2.5 sm:py-1.5 rounded-lg text-xs font-semibold text-slate-700 flex items-center gap-1.5" title="Appearance & Performance Settings">
                    <i class="ph-bold ph-gear text-sky-600 text-sm"></i>
                    <span class="hidden lg:inline">Settings</span>
                </button>

                <button id="toggle-preview-btn" onclick="togglePreviewPane()" class="aero-btn px-3 py-1.5 rounded-lg text-xs font-semibold text-slate-700 flex items-center gap-1.5" title="Toggle Live Split Preview">
                    <i class="ph-bold ph-columns text-sky-600 text-sm"></i>
                    <span class="hidden sm:inline">Split Preview</span>
                </button>

                <button onclick="runCode(true)" class="aero-run-btn px-3.5 py-1.5 rounded-lg text-xs font-bold flex items-center gap-1.5 cursor-pointer">
                    <i class="ph-fill ph-play text-xs"></i>
                    <span>Run</span>
                </button>
            </div>
        </header>

        <!-- Workspace Body (Sidebar + Editor + Live Preview) -->
        <div class="flex-1 flex overflow-hidden relative">
            
            <!-- Collapsible Frosted File Explorer Sidebar -->
            <aside id="sidebar" class="w-56 sm:w-60 bg-white/30 border-r border-white/60 flex flex-col shrink-0 transition-all duration-300 overflow-hidden">
                <div class="px-4 py-3 flex items-center justify-between border-b border-white/45">
                    <span class="dark-text-muted text-[11px] font-bold uppercase tracking-wider text-slate-600 flex items-center gap-1.5">
                        <i class="ph-duotone ph-folder-open text-sky-600 text-sm"></i>
                        Project Files
                    </span>
                    <button onclick="createNewFile()" class="p-1 rounded-md hover:bg-white/60 text-sky-700 transition" title="New File">
                        <i class="ph-bold ph-plus text-xs"></i>
                    </button>
                </div>

                <!-- File Tree List -->
                <div id="file-tree" class="flex-1 p-2 space-y-1 overflow-y-auto">
                    <!-- Populated dynamically via JS -->
                </div>

                <!-- Aero Storage / Aqua Widget Card in Sidebar -->
                <div class="dark-surface-pill p-3 m-2.5 rounded-xl bg-gradient-to-b from-white/65 to-sky-100/45 border border-white/80 shadow-sm">
                    <div class="flex items-center justify-between mb-1.5">
                        <span class="dark-text-light text-[11px] font-semibold text-slate-700 flex items-center gap-1">
                            <i class="ph-fill ph-drop text-sky-500"></i> Aqua Engine
                        </span>
